# Hugging Face token with access to black-forest-labs/FLUX.1-dev
# (accept the license at https://huggingface.co/black-forest-labs/FLUX.1-dev first)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# auto | gpu | model | sequential
#   auto       -> full GPU if >=36 GB VRAM, model CPU offload if >=12 GB, else sequential offload
#   gpu        -> pipe.to("cuda")                    (40 GB+ cards: A100/H100/L40S/RTX 6000)
#   model      -> pipe.enable_model_cpu_offload()     (16-24 GB cards: RTX 4090/3090/5080)
#   sequential -> pipe.enable_sequential_cpu_offload() (<12 GB, slow)
OFFLOAD_MODE=auto

MODEL_ID=black-forest-labs/FLUX.1-dev
